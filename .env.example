# SparesX environment template — copy to `.env` and fill values.
# Never commit real secrets.

# --- Required ---
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/sparesx
JWT_SECRET=change-me-to-a-long-random-string
# Deploy / SSR self-fetch base (may be a preview URL in non-prod)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Public canonical host for SEO (canonicals, OG, robots, sitemap).
# Do NOT reuse NEXT_PUBLIC_BASE_URL here — preview URLs must not poison SEO.
NEXT_PUBLIC_SITE_URL=https://www.sparesx.com

# Vercel Blob (uploads in production)
# BLOB_READ_WRITE_TOKEN=

# --- Email (password reset + verification) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Or: EMAIL_USER= / EMAIL_PASSWORD=

# Encrypt Site Settings secrets (SMS/SMTP overrides) — min 32 chars
# SETTINGS_ENCRYPTION_KEY=

# OTP hashing pepper (recommended; falls back to JWT_SECRET if unset)
# OTP_PEPPER=

# --- Google Sign-In ---
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_ID=

# See docs/PRODUCTION-ENV.md for full production checklist.

# --- Chat / Socket.io companion ---
SOCKET_PORT=4001
SOCKET_CORS_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_SOCKET_URL=https://your-socket-host.example.com

# --- Optional scale / notify ---
# REDIS_URL=
# SOCKET_REDIS_URL=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@example.com
# ATLAS_SEARCH_INDEX=products
# OTP_PEPPER=

# Optional error monitoring (Sentry) — leave unset to disable
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Mongo DB name override
# MONGODB_DB_NAME=sparesx

# Google AdSense site snippet is in src/components/AdSenseScript.tsx (ca-pub-8411517519858379).
# Set true only when you want reserved AdSlot placeholders to render.
# NEXT_PUBLIC_ADS_ENABLED=true
