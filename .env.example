# SparesX environment template — copy to `.env` and fill values.
# Never commit real secrets.

# --- Required ---
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/sparesx
JWT_SECRET=change-me-to-a-long-random-string
# Deploy / SSR self-fetch base (may be a preview URL in non-prod)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Public canonical host for SEO (canonicals, OG, robots, sitemap).
# Do NOT reuse NEXT_PUBLIC_BASE_URL here — preview URLs must not poison SEO.
NEXT_PUBLIC_SITE_URL=https://www.sparesx.com

# Vercel Blob (uploads in production)
# BLOB_READ_WRITE_TOKEN=

# --- Email (password reset + verification) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Or: EMAIL_USER= / EMAIL_PASSWORD=

# Encrypt Site Settings secrets (SMS/SMTP overrides) — min 32 chars
# SETTINGS_ENCRYPTION_KEY=

# --- Google Sign-In ---
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_ID=

# --- Chat / Socket.io companion ---
SOCKET_PORT=4001
SOCKET_CORS_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_SOCKET_URL=https://your-socket-host.example.com

# --- Optional scale / notify ---
# REDIS_URL=
# SOCKET_REDIS_URL=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@example.com
# ATLAS_SEARCH_INDEX=products
# OTP_PEPPER=

# Mongo DB name override
# MONGODB_DB_NAME=sparesx
