# Chat / realtime env

# Already used by the app:
# MONGODB_URI=...
# JWT_SECRET=...

# Google Sign-In (OAuth 2.0 Web Client ID from Google Cloud Console)
# Add the same Client ID for browser (GIS) and server token verify.
# Authorized JavaScript origins must include http://localhost:3000 and your production URL.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: external Socket.IO host (Railway / Render / Fly).
# Vercel cannot host Socket.IO. If unset, SparesX uses REST presence + polling
# which works on Vercel for online status, typing, and near-instant messages.
# NEXT_PUBLIC_SOCKET_URL=https://your-socket-host.example.com

# Local companion server only:
SOCKET_PORT=4001
SOCKET_CORS_ORIGIN=http://localhost:3000
